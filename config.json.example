{
  "traders": [
    {
      "id": "hyperliquid_deepseek",
      "name": "Hyperliquid DeepSeek Trader",
      "enabled": true,
      "ai_model": "deepseek",
      "exchange": "hyperliquid",
      "hyperliquid_private_key": "your_ethereum_private_key_without_0x_prefix",
      "hyperliquid_wallet_addr": "your_ethereum_address",
      "hyperliquid_testnet": false,
      "deepseek_key": "your_deepseek_api_key",
      "initial_balance": 1000,
      "scan_interval_minutes": 3
    },
    {
      "id": "binance_qwen",
      "name": "Binance Qwen Trader",
      "enabled": true,
      "ai_model": "qwen",
      "exchange": "binance",
      "binance_api_key": "your_binance_api_key",
      "binance_secret_key": "your_binance_secret_key",
      "qwen_key": "your_qwen_api_key",
      "initial_balance": 1000,
      "scan_interval_minutes": 3
    },
    {
      "id": "binance_custom",
      "name": "Binance Custom API Trader",
      "enabled": false,
      "ai_model": "custom",
      "exchange": "binance",
      "binance_api_key": "your_binance_api_key",
      "binance_secret_key": "your_binance_secret_key",
      "custom_api_url": "https://api.openai.com/v1",
      "custom_api_key": "sk-your-api-key",
      "custom_model_name": "gpt-4o",
      "initial_balance": 1000,
      "scan_interval_minutes": 3
    },
    {
      "id": "binance_chanlun_programmatic",
      "name": "Binance Chanlun Programmatic Trader",
      "enabled": false,
      "decision_mode": "programmatic",
      "exchange": "binance",
      "binance_api_key": "your_binance_api_key",
      "binance_secret_key": "your_binance_secret_key",
      "initial_balance": 1000,
      "scan_interval_minutes": 3,
      "programmatic_strategy": {
        "strategy_name": "chanlun_programmatic",
        "strategy_version": "v1",
        "allow_long": true,
        "allow_short": true,
        "enabled_signals": ["buy1", "buy2", "buy3", "sell1", "sell2", "sell3"],
        "timeframes": {
          "higher": "4h",
          "trade": "1h",
          "sub": "15m",
          "micro": "3m"
        },
        "history_depth": {
          "3m": 240,
          "15m": 192,
          "1h": 240,
          "4h": 180
        },
        "symbol_pool": {
          // append: 追加到动态池；override: 只看自定义池；filter: 从动态池中过滤。
          "mode": "append",
          "symbols": ["BTCUSDT", "ETHUSDT"]
        },
        "moving_average": {
          "short_period": 20,
          "long_period": 50
        },
        "structure": {
          "strictness": "enhanced",
          "left_bars": 2,
          "right_bars": 2,
          "min_stroke_bars": 5,
          "min_swing_pct": 0.3,
          "atr_multiplier": 0.5
        },
        "divergence": {
          "ratio": 0.8,
          "price_tolerance_pct": 0.1,
          "price_tolerance_atr_multiplier": 0.2
        },
        "adx": {
          "period": 14,
          "min_adx": 20,
          "micro_adx_filter": false
        },
        "position": {
          "max_add_count": 2,
          "add_size_multiplier": 0.5,
          "partial_close_pct": 30,
          "allow_reversal": false
        },
        "take_profit": {
          "mode": "structure",
          "fallback_mode": "reject",
          "min_net_rr": 2.5
        },
        "state": {
          "path": "data/programmatic_strategy_state.json",
          "bootstrap": false
        }
      }
    },
    {
      "id": "aster_deepseek",
      "name": "Aster DeepSeek Trader",
      "enabled": true,
      "ai_model": "deepseek",
      "exchange": "aster",

      // 注意请仔细阅读这三个提示 请进入https://www.asterdex.com/en/api-wallet网站 -> 选择专业api -> 创建新api获取以下信息
      // user: 主钱包地址 (登录地址/连接到aster的钱包地址)
      // signer: API钱包地址 (点击生成地址后生成的地址)
      // privateKey: API钱包私钥 (生成地址对应的私钥)

      "aster_user": "0x63DD5aCC6b1aa0f563956C0e534DD30B6dcF7C4e",
      "aster_signer": "0x21cF8Ae13Bb72632562c6Fff438652Ba1a151bb0",
      "aster_private_key": "your_aster_api_wallet_private_key_without_0x_prefix",

      "deepseek_key": "your_deepseek_api_key",
      "initial_balance": 1000.0,
      "scan_interval_minutes": 3
    }
  ],
  "leverage": {
    "btc_eth_leverage": 5,
    "altcoin_leverage": 5
  },
  "use_default_coins": true,
  "default_coins": [
    "BTCUSDT",
    "ETHUSDT",
    "SOLUSDT",
    "BNBUSDT",
    "XRPUSDT",
    "DOGEUSDT",
    "ADAUSDT",
    "HYPEUSDT"
  ],
  "coin_pool_api_url": "",
  "oi_top_api_url": "",
  "dynamic_candidate_pool": {
    "enabled": true,
    "refresh_hour": 8,
    "ttl_hours": 24,
    "min_pool_size": 15,
    "max_pool_size": 30,
    "prompt_candidate_limit": 8,
    "core_symbols": ["BTCUSDT", "ETHUSDT"],
    "min_oi_value_usd": 15000000,
    "min_quote_volume_24h_usd": 20000000,
    "cooldown_days_after_losses": 2,
    "exchange_volume_top_limit": 30,
    "snapshot_path": "data/dynamic_candidate_pool.json"
  },
  "trading_frequency": {
    // 推荐首次上线使用 balanced：AI新机会分析间隔12分钟，prompt候选10个，高ADX/RR/rolling放宽仅report-only。
    "mode": "balanced"

    // 可选 safe：
    // "mode": "safe"

    // 可选 active：
    // "mode": "active",
    // "analysis_interval_minutes": 9,
    // "prompt_candidate_limit": 12,
    // "daily_open_limit": 4,
    // "rollback_window_hours": 24,
    // "rollback_min_profit_factor": 0.8,
    // "rollback_max_drawdown_pct": 2.0
    //
    // 注意：active触发运行时回退到safe开仓行为时，不会动态缩小候选池prompt_candidate_limit；
    // 如需改变候选数量，请修改配置并重启服务。
  },
  "api_server_port": 8080,
  "max_daily_loss": 10.0,
  "max_drawdown": 20.0,
  "stop_trading_minutes": 60
}
