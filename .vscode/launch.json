{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch NOFX",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "CGO_ENABLED": "1"
            },
            "args": []
        },
        {
            "name": "Attach to Delve",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "${workspaceFolder}",
            "port": 2345,
            "host": "localhost"
        }
    ]
}
