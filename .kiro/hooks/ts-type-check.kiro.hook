{
  "enabled": true,
  "name": "TypeScript 类型检查",
  "description": "当前端 TypeScript 文件被编辑保存时，自动运行 tsc 类型检查，确保类型安全。",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "web/src/**/*.ts",
      "web/src/**/*.tsx"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npx tsc --noEmit",
    "timeout": 30
  }
}