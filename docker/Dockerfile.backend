# docker/backend/Dockerfile

# ═══════════════════════════════════════════════════════════════
# NOFX Backend Dockerfile (Go + TA-Lib)
# Multi-stage build with shared TA-Lib compilation stage
# Versions extracted as ARGs for maintainability
# ═══════════════════════════════════════════════════════════════

ARG GO_VERSION=1.25-bookworm
ARG DEBIAN_VERSION=bookworm
ARG PYTHON_VERSION=3.11
ARG TORCH_VERSION=2.7.1
ARG TA_LIB_VERSION=0.4.0

# ──────────────────────────────────────────────────────────────
# TA-Lib Build Stage (shared across builds)
# ──────────────────────────────────────────────────────────────
FROM debian:${DEBIAN_VERSION}-slim AS ta-lib-builder
ARG TA_LIB_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates wget tar make gcc g++ autoconf automake \
    && rm -rf /var/lib/apt/lists/*

RUN wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    tar -xzf ta-lib-${TA_LIB_VERSION}-src.tar.gz && \
    cd ta-lib && \
    if [ "$(uname -m)" = "aarch64" ]; then \
        CONFIG_GUESS=$(find /usr/share -name config.guess | head -1) && \
        CONFIG_SUB=$(find /usr/share -name config.sub | head -1) && \
        cp "$CONFIG_GUESS" config.guess && \
        cp "$CONFIG_SUB" config.sub && \
        chmod +x config.guess config.sub; \
    fi && \
    ./configure --prefix=/usr/local && \
    make && make install && \
    cd .. && rm -rf ta-lib ta-lib-${TA_LIB_VERSION}-src.tar.gz

# ──────────────────────────────────────────────────────────────
# Rust Chanlun V2 Build Stage
# ──────────────────────────────────────────────────────────────
FROM rust:1.83-bookworm AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY chanlun_v2/ .
RUN cargo build --release && \
    cp target/release/libchanlun_v2.a /usr/local/lib/

# ──────────────────────────────────────────────────────────────
# Backend Build Stage (Go Application)
# ──────────────────────────────────────────────────────────────
FROM golang:${GO_VERSION} AS backend-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git make gcc g++ libc6-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ta-lib-builder /usr/local /usr/local
COPY --from=rust-builder /usr/local/lib/libchanlun_v2.a /usr/local/lib/

ENV LD_LIBRARY_PATH=/usr/local/lib

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN ldconfig && CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o nofx .

# ──────────────────────────────────────────────────────────────
# Runtime Stage (Backend + DRL-PPO training environment)
# ──────────────────────────────────────────────────────────────
FROM python:${PYTHON_VERSION}-slim-bookworm
ARG TORCH_VERSION

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    LD_LIBRARY_PATH=/usr/local/lib

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata wget libgcc-s1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ta-lib-builder /usr/local /usr/local
COPY --from=rust-builder /usr/local/lib/libchanlun_v2.a /usr/local/lib/
WORKDIR /app
COPY --from=backend-builder /app/nofx .
COPY --from=backend-builder /app/training/drl/requirements.txt ./training/drl/requirements.txt
RUN python -m pip install --upgrade pip setuptools wheel \
    && python -m pip install --index-url https://download.pytorch.org/whl/cpu "torch==${TORCH_VERSION}+cpu" \
    && python -m pip install -r training/drl/requirements.txt
COPY --from=backend-builder /app/training/drl ./training/drl

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/health || exit 1

CMD ["./nofx"]
