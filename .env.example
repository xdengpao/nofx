# NOFX Environment Variables Template
# Copy this file to .env and modify the values as needed

# Ports Configuration
# Backend API server port (internal: 8080, external: configurable)
NOFX_BACKEND_PORT=8080

# Frontend web interface port (Nginx listens on port 80 internally)
NOFX_FRONTEND_PORT=3000
# 前端 Basic Auth htpasswd 文件。默认账号 admin，默认密码 nofx123456。
# 生产环境建议复制 nginx/.htpasswd.example 到 nginx/.htpasswd，改密码后设置为 ./nginx/.htpasswd。
NOFX_FRONTEND_HTPASSWD_PATH=./nginx/.htpasswd.example

# Timezone Setting
# System timezone for container time synchronization
NOFX_TIMEZONE=Asia/Shanghai

# Runtime Storage
# Docker Compose 默认将项目本地 ./runtime 挂载到容器 /app/runtime。
# 如需使用外置盘，可设置 NOFX_RUNTIME_HOST_PATH=/Volumes/light2/nofx。
NOFX_RUNTIME_HOST_PATH=./runtime
NOFX_CONTAINER_STORAGE_ROOT=/app/runtime
# 可选：Docker Desktop/macOS bind mount 容量可能不准；需要 UI 显示宿主机真实容量时，
# 用 `df -k <NOFX_RUNTIME_HOST_PATH>` 计算 total/free 后填入 bytes。
NOFX_STORAGE_DISK_TOTAL_BYTES=
NOFX_STORAGE_DISK_FREE_BYTES=

# DRL-PPO Training
# Docker 后端镜像内置 CPU 训练依赖；训练 API 默认关闭，需要确认本机资源后显式开启。
NOFX_DRL_TRAIN_API_ENABLED=false
NOFX_DRL_TRAIN_PYTHON_BIN=python3
